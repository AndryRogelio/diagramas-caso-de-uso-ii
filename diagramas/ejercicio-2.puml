@startuml
left to right direction
skinparam packageStyle rectangle

actor "Cliente" as C
actor "Pasarela de Pagos" as PP
actor "Administrador" as A

package "Gestión de Pedidos y Pagos" {
    usecase "Realizar Compra" as UC_COMPRA
    usecase "Procesar Pago" as UC_PAGO
    usecase "Aplicar Cupón de Descuento" as UC_CUPON
    usecase "Generar Factura" as UC_FACTURA
    usecase "Cancelar Pedido" as UC_CANCELAR
}

C --> UC_COMPRA : "Inicia selección"
C --> UC_CANCELAR : "Solicita anulación"
A --> UC_CANCELAR : "Autoriza anulación"

UC_COMPRA ..> UC_PAGO : <<include>>
UC_PAGO ..> UC_FACTURA : <<include>>
UC_CUPON ..> UC_COMPRA : <<extend>>

UC_PAGO ..> PP : "Verifica transacción bancaria"

note right of UC_PAGO
  Permite tarjeta de crédito, débito
  y transferencia bancaria directa.
end note
@enduml
